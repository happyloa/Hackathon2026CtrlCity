# Raw source data is kept locally; it is too large for the repository.
docs/資料集/

# app/public/data/roi/station-details.bin (the per-station raw drill-down,
# regenerated by `npm run data:profile`) IS committed: it's one binary file,
# packed to ~27MB, fetched per-station via HTTP Range requests. The ROI page
# degrades gracefully if it is ever absent (stale local checkout, etc).

# Dev-only mirror of the replay/live-profile build output (normally only
# written to app/dist/ by stage-pages-static.mjs). Regenerated by predev via
# scripts/export-dev-static.mjs so `npm run dev` has station popularity and
# replay data without a full build.
app/public/data/replay/
app/public/data/live-profile/

# ML PoC: derived data, model artifacts and the local virtual environment.
ml/data/
ml/output/
ml/.venv/
__pycache__/

# Ad hoc analysis reports for local review; not build output, not final artifacts.
# docs/_scratch/
