{
  "name": "hackathon2026ctrlcity",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/validate-type-scale.mjs && node scripts/evaluate-operational-impact.mjs && nuxi generate && node scripts/stage-pages-static.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "build:cloudflare": "node scripts/validate-type-scale.mjs && node scripts/evaluate-operational-impact.mjs && nuxi generate && node scripts/stage-pages-static.mjs",
    "postinstall": "nuxt prepare",
    "data:build": "node scripts/build-artifacts.mjs && node scripts/evaluate-operational-impact.mjs",
    "data:validate": "node scripts/validate-artifacts.mjs",
    "model:evaluate": "node scripts/evaluate-forecast.mjs",
    "data:profile": "node --max-old-space-size=12288 scripts/station-time-profile.mjs",
    "data:frozen": "node scripts/detect-frozen-stations.mjs",
    "data:live-static": "node scripts/export-dev-static.mjs",
    "predict:xgboost": "node scripts/predict-xgboost.mjs",
    "impact:evaluate": "node scripts/evaluate-operational-impact.mjs",
    "aws:preflight": "node scripts/aws-preflight.mjs",
    "aws:deploy": "node scripts/aws-deploy.mjs",
    "aws:publish": "node scripts/aws-publish.mjs",
    "aws:knowledge": "node scripts/aws-upload-knowledge.mjs",
    "aws:smoke": "node scripts/aws-smoke.mjs",
    "test": "node scripts/validate-type-scale.mjs && node --test tests/*.test.mjs",
    "typecheck": "nuxt typecheck",
    "type:validate": "node scripts/validate-type-scale.mjs",
    "aws:rebuild": "node scripts/aws-rebuild.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1116.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@iconify/vue": "^5.0.1",
    "@lucide/vue": "^1.41.0",
    "font-gis": "^1.0.6",
    "leaflet": "^1.9.4",
    "nuxt": "4.5.2",
    "oidc-client-ts": "^3.5.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "csv-parse": "^7.0.2",
    "esbuild": "0.28.1",
    "iconv-lite": "^0.7.3",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vue-tsc": "3.3.11",
    "wrangler": "4.125.0",
    "yaml": "^2.9.0"
  }
}
