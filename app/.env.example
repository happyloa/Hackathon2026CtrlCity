# Public, build-time endpoint for the read-only live station proxy.
# Cloudflare Pages keeps the relative default. The final AWS deployment can
# keep this same path behind CloudFront, or set it to the public API Gateway URL.
NUXT_PUBLIC_LIVE_STATIONS_ENDPOINT=/api/v1/live-stations

# AI review remains off until the formal AWS stack reports AgentReviewEnabled=true.
# These values are public browser configuration; the Harness ARN stays in Lambda only.
NUXT_PUBLIC_AGENT_ENABLED=false
NUXT_PUBLIC_AGENT_REVIEW_ENDPOINT=/api/v1/agent-review

# Never put AWS access keys, AgentCore ARNs, Bedrock credentials, or S3 bucket
# secrets in this file. The browser receives only public same-origin API paths.
